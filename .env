# Database Configuration
POSTGRES_DB=ckan
POSTGRES_USER=ckan
POSTGRES_PASSWORD=ckan
POSTGRES_HOST=db
POSTGRES_PORT=5432

# CKAN Configuration
CKAN_SITE_URL=http://localhost:5000
CKAN_SITE_ID=default
CKAN_STORAGE_PATH=/var/lib/ckan

# Security Keys (Change these in production!)
CKAN___BEAKER__SESSION__SECRET=your-secret-key-here-change-this-in-production
CKAN__API_TOKEN__JWT__ENCODE__SECRET=your-jwt-encode-secret-here
CKAN__API_TOKEN__JWT__DECODE__SECRET=your-jwt-decode-secret-here

# Solr Configuration
SOLR_URL=http://solr:8983/solr/ckan

# Redis Configuration
REDIS_URL=redis://redis:6379/1

# CKAN Plugins
CKAN__PLUGINS=image_view text_view datatables_view datastore envvars

# DataPusher Configuration
DATAPUSHER_MAX_CONTENT_LENGTH=10485760
DATAPUSHER_CHUNK_SIZE=16384
DATAPUSHER_CHUNK_INSERT_TIMEOUT=5
DATAPUSHER_DOWNLOAD_TIMEOUT=30

# SMTP Configuration (Optional - uncomment and configure for email)
# CKAN_SMTP_SERVER=smtp.gmail.com
# CKAN_SMTP_STARTTLS=True
# CKAN_SMTP_USER=your-email@gmail.com
# CKAN_SMTP_PASSWORD=your-password
# CKAN_SMTP_MAIL_FROM=your-email@gmail.com